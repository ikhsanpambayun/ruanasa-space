# Ruanasa Space Web — environment variables (TAD v1.6 Section 21.2)
# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# Hanya variabel NEXT_PUBLIC_* yang boleh ada di sini: nilainya terlihat di browser, jadi tidak boleh berisi secret
# (server key Midtrans, JWT secret, service key Supabase hanya ada di backend).

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_SUPABASE_URL=
