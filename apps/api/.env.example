# Ruanasa Space API — environment variables (TAD v1.6 Section 21.2)
# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# Variabel bertanda [WAJIB] membuat server gagal start bila kosong.

# --- Application ---
# development | staging | production
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# [WAJIB] DATABASE_URL: connection string PgBouncer (port 6543). DIRECT_URL: koneksi langsung (port 5432) untuk migrasi.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- JWT ---
# [WAJIB] Minimal 32 karakter (256-bit), unik per environment. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=7d

# --- Seed (hanya dipakai `yarn prisma:seed`, bukan oleh server) ---
# Password akun admin awal (admin@ruanasaspace.com). Wajib saat seed; jangan memakai nilai contoh di production.
SEED_ADMIN_PASSWORD=

# --- CORS ---
# Daftar origin frontend dipisah koma. Wajib di staging/production; di development default http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payment Gateway (Midtrans) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=http://localhost:3001/api/v1/payments/webhook

# --- WhatsApp ---
# fonnte | wablas
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=

# --- Email (Resend) ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@ruanasaspace.com
EMAIL_FROM_NAME=Ruanasa Space

# --- Storage (Supabase Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=public
